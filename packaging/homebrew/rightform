#!/bin/zsh
# Command companion distributed beside Rightform.app in the Homebrew Cask ZIP.

set -euo pipefail

app_path="/Applications/Rightform.app"

restart_app() {
  if /usr/bin/pgrep -x Rightform >/dev/null 2>&1; then
    /usr/bin/osascript -e 'tell application id "com.rightform.app" to quit' >/dev/null 2>&1 || true

    for _ in {1..50}; do
      if ! /usr/bin/pgrep -x Rightform >/dev/null 2>&1; then
        break
      fi
      /bin/sleep 0.2
    done

    if /usr/bin/pgrep -x Rightform >/dev/null 2>&1; then
      print -u2 "Rightform is still closing. Close it, then run: rightform app"
      return 1
    fi
  fi

  if [[ ! -d "$app_path" ]]; then
    print -u2 "Rightform was updated, but the app bundle is missing from $app_path."
    return 1
  fi

  print "Opening Rightform…"
  /usr/bin/open -n "$app_path"
}

installed_version() {
  /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app_path/Contents/Info.plist" 2>/dev/null || print 'unknown'
}

case "${1:-info}" in
  info)
    print "Rightform $(installed_version)"
    print "Installed through Homebrew Cask."
    print "Use: rightform update | rightform app"
    ;;
  update)
    before="$(installed_version)"
    brew upgrade --cask prisonmike420/rightform/rightform
    after="$(installed_version)"

    if [[ "$before" == "$after" ]]; then
      print -u2 "Homebrew did not install a newer Rightform (still $after)."
      print -u2 "Check that the tap points here: brew tap --custom-remote prisonmike420/rightform https://github.com/prisonmike420/rightform"
      exit 1
    fi

    print "Rightform updated from $before to $after."
    restart_app
    ;;
  app)
    /usr/bin/open -n "$app_path"
    ;;
  *)
    print -u2 "Usage: rightform [info|update|app]"
    exit 64
    ;;
esac
