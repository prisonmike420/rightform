class Imgless < Formula
  desc "Native macOS batch optimizer for JPEG, PNG and WebP files"
  homepage "https://github.com/prisonmike420/musical-octo-meme"
  url "https://github.com/prisonmike420/musical-octo-meme/archive/refs/tags/v0.15.1.tar.gz"
  sha256 "REPLACE_WITH_GITHUB_TAG_ARCHIVE_SHA256"
  license :cannot_represent

  depends_on :macos
  depends_on "jpeg-archive"
  depends_on "jpeg-turbo"
  depends_on "oxipng"
  depends_on "pngquant"
  depends_on "webp"

  def install
    system "scripts/build-app.sh", buildpath/"IMGLESS.app"
    libexec.install "IMGLESS.app"

    (bin/"imgless").write <<~EOS
      #!/bin/zsh
      exec /usr/bin/open "#{libexec}/IMGLESS.app"
    EOS
    chmod 0755, bin/"imgless"
  end

  test do
    assert_predicate libexec/"IMGLESS.app/Contents/MacOS/IMGLESS", :executable?
  end
end
