#!/bin/zsh
# Command companion distributed beside Stou.app in the Homebrew Cask ZIP.

set -euo pipefail

app_path="/Applications/Stou.app"

restart_app() {
  if /usr/bin/pgrep -x Stou >/dev/null 2>&1; then
    /usr/bin/osascript -e 'tell application id "com.stou.app" to quit' >/dev/null 2>&1 || true

    for _ in {1..50}; do
      if ! /usr/bin/pgrep -x Stou >/dev/null 2>&1; then
        break
      fi
      /bin/sleep 0.2
    done

    if /usr/bin/pgrep -x Stou >/dev/null 2>&1; then
      print -u2 "Stou is still closing. Close it, then run: stou app"
      return 1
    fi
  fi

  if [[ ! -d "$app_path" ]]; then
    print -u2 "Stou was updated, but the app bundle is missing from $app_path."
    return 1
  fi

  print "Opening Stou…"
  /usr/bin/open -n "$app_path"
}

installed_version() {
  /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app_path/Contents/Info.plist" 2>/dev/null || print 'unknown'
}

case "${1:-info}" in
  info)
    print "Stou $(installed_version)"
    print "Installed through Homebrew Cask."
    print "Use: stou update | stou app"
    ;;
  update)
    before="$(installed_version)"
    # By token alone: taps added as prisonmike420/rightform (before the
    # rename) and as prisonmike420/stou both resolve it.
    brew upgrade --cask stou
    after="$(installed_version)"

    if [[ "$before" == "$after" ]]; then
      print -u2 "Homebrew did not install a newer Stou (still $after)."
      print -u2 "Point the tap at this repository, then retry: brew tap --custom-remote prisonmike420/stou https://github.com/prisonmike420/stou"
      exit 1
    fi

    print "Stou updated from $before to $after."
    restart_app
    ;;
  app)
    /usr/bin/open -n "$app_path"
    ;;
  *)
    print -u2 "Usage: stou [info|update|app]"
    exit 64
    ;;
esac
